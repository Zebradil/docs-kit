    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "ajv": "8.20.0",
    "astro": "7.4.8",
    "yaml": "2.9.1"
  },
  "version": "0.10.0"
}
